*.sh text eol=lf
*.bat text eol=crlf

# Large binary files are stored with Git LFS (https://git-lfs.com): git keeps a small pointer, GitHub keeps the file.
# Run `git lfs install` once per computer before cloning or committing.
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
